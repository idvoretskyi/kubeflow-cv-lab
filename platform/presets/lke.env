# platform/presets/lke.env — Linode/Akamai LKE preset.
#
# Captures the exact configuration for a Linode Kubernetes Engine (LKE) cluster
# with Calico BGP CNI. Use via:
#   PRESET=lke make platform-install
# or:
#   PRESET=lke ./platform/install.sh
#
# Why cidrs mode for LKE:
#   Calico on LKE runs in BGP mode and does NOT set .spec.podCIDR on nodes,
#   so the "auto" detection falls back to open. Using cidrs mode with the known
#   LKE CIDRs gives a more precise, tested NetworkPolicy patch.
#
# CIDRs:
#   KF_APISERVER_CIDRS — the Linode LKE private node address range (all LKE
#                        nodes, including control-plane, live in this /17).
#   KF_POD_CIDR        — the Calico pod CIDR assigned to LKE clusters.

KF_WEBHOOK_ACCESS=cidrs
KF_APISERVER_CIDRS=192.168.128.0/17
KF_POD_CIDR=10.2.0.0/16

# Reference cluster (akamai-lke-gpu-cluster): 1x g6-standard-2 system node +
# 1x g2-gpu-rtx4000a1-s (RTX 4000 Ada). The minimal profile is required to fit.
KF_PROFILE=minimal

# Optional strict pinning of GPU pipeline steps to the LKE GPU pool (label set by
# akamai-lke-gpu-cluster). Consumed by pipeline/gpu_scheduling.py at compile
# time, e.g.:  set -a; . platform/presets/lke.env; set +a; make compile
# The committed pipeline YAML keeps the vendor-neutral GFD label instead.
# GPU_NODE_SELECTOR_KEY=nodepool.lke/role
# GPU_NODE_SELECTOR_VALUE=gpu
