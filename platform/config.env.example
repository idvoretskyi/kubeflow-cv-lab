# platform/config.env — Kubeflow installer configuration.
#
# Copy this file to platform/config.env and edit as needed:
#   cp platform/config.env.example platform/config.env
#
# platform/config.env is git-ignored (real cluster settings stay local).
# Env vars set in the shell always take precedence over this file.
# Named cluster presets live in platform/presets/<name>.env.
#
# See platform/README.md for full documentation.

# ---------------------------------------------------------------------------
# Kubeflow version
# ---------------------------------------------------------------------------

# Git tag of kubeflow/manifests to install. Supports CalVer (YY.MM) and
# semver (vX.Y.Z) tags as published at:
#   https://github.com/kubeflow/manifests/tags
KF_VERSION=26.03

# ---------------------------------------------------------------------------
# GPU scheduling
# ---------------------------------------------------------------------------

# Taint key on GPU nodes. Kubeflow control-plane Deployments and StatefulSets
# are patched with a matching toleration so they can land on tainted GPU nodes
# when the system pool is under pressure.
# Set to "" to skip the toleration patch entirely (untainted GPU nodes, or
# when you want Kubeflow control-plane strictly on non-GPU nodes).
KF_GPU_TOLERATION_KEY=nvidia.com/gpu

# ---------------------------------------------------------------------------
# Webhook access (KF_WEBHOOK_ACCESS)
#
# The upstream kubeflow-system NetworkPolicy restricts ingress to same-
# namespace pods only, which blocks the Kubernetes API server from reaching
# admission webhooks (jobset-controller-manager, trainer-controller-manager).
# Without a fix, TrainJob creation times out with "context deadline exceeded".
#
# Available modes:
#
#   auto  (default)
#     Detect cluster sources at runtime:
#       - Node InternalIPs  (/32)
#       - kubernetes Service endpoint IPs  (/32)
#       - Per-node .spec.podCIDR (set by most CNI plugins)
#     Builds ipBlock rules from what it finds. If nothing is detected (e.g.
#     Calico BGP mode does not populate .spec.podCIDR), falls back to "open"
#     automatically with a printed notice.
#     Recommended for most clusters; zero-config.
#
#   open
#     Patches the policy to allow all sources (0.0.0.0/0).
#     Bulletproof; suitable for lab environments.
#
#   cidrs
#     Uses explicit KF_APISERVER_CIDRS / KF_POD_CIDR values (see below).
#     Best for hardened deployments or tested/reproducible paths where exact
#     CIDRs are known (e.g. via a named preset).
#
#   skip
#     Leaves the NetworkPolicy unpatched. Use when:
#       - The cluster has no NetworkPolicy enforcement (policy objects are inert).
#       - The cluster already allows API-server → kubeflow-system ingress.
#     If TrainJob creation times out after choosing skip, re-run with auto.
#
# ---------------------------------------------------------------------------
KF_WEBHOOK_ACCESS=auto

# CIDRs for cidrs mode only — ignored by auto / open / skip.
# KF_APISERVER_CIDRS=   # comma-separated node/control-plane CIDRs
# KF_POD_CIDR=          # pod network CIDR

# How to find the right values for cidrs mode:
#
#   Node / API-server CIDR (KF_APISERVER_CIDRS):
#     kubectl get nodes -o wide      # look at INTERNAL-IP column; find the subnet
#
#   Pod CIDR (KF_POD_CIDR):
#     kubectl cluster-info dump | grep -m1 cluster-cidr
#     # or check your CNI config (Calico, Flannel, Cilium, etc.)
#
# Named presets for common environments (use with PRESET=<name>):
#   platform/presets/lke.env  — Linode/Akamai LKE (Calico BGP, cidrs mode)
