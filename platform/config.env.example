# platform/config.env — Kubeflow installer configuration.
#
# Copy this file to platform/config.env and edit as needed:
#   cp platform/config.env.example platform/config.env
#
# platform/config.env is git-ignored (real cluster settings stay local).
# Env vars set in the shell always take precedence over this file.
#
# See platform/README.md for a full description of every variable and how to
# find the right values for your cloud provider.

# ---------------------------------------------------------------------------
# Kubeflow version
# ---------------------------------------------------------------------------

# Git tag of kubeflow/manifests to install. Supports CalVer (YY.MM) and
# semver (vX.Y.Z) tags as published at:
#   https://github.com/kubeflow/manifests/tags
KF_VERSION=26.03

# ---------------------------------------------------------------------------
# GPU scheduling
# ---------------------------------------------------------------------------

# Taint key on GPU nodes. Kubeflow control-plane pods are patched with a
# matching toleration so they can schedule onto GPU nodes when the system
# pool is exhausted.
# Set to "" to disable the toleration patch entirely.
KF_GPU_TOLERATION_KEY=nvidia.com/gpu

# ---------------------------------------------------------------------------
# Webhook NetworkPolicy patch
#
# The upstream kubeflow-system NetworkPolicy blocks the Kubernetes API server
# from reaching admission webhook pods (jobset, trainer controllers). Without
# this patch, TrainJob creation times out with "context deadline exceeded".
#
# Set the CIDRs that match your cluster's API-server nodes and pod network so
# webhook calls can get through.
#
# How to find the right values for your cloud:
#
#   API-server CIDR (KF_APISERVER_CIDRS):
#     This is the IP range of the control-plane/worker nodes as seen from
#     inside the cluster. For managed K8s services it is typically the VPC or
#     node subnet CIDR. Check your cloud console or:
#       kubectl get nodes -o wide   # look at the INTERNAL-IP column
#
#   Pod CIDR (KF_POD_CIDR):
#     The pod network CIDR configured for your CNI plugin. Check with:
#       kubectl cluster-info dump | grep -m1 cluster-cidr
#     or in your CNI config (Calico, Flannel, Cilium, etc.).
#
# Multiple API-server CIDRs can be specified as a comma-separated list:
#   KF_APISERVER_CIDRS=10.0.0.0/8,192.168.1.0/24
#
# Set either variable to "" to skip the NetworkPolicy patch entirely
# (useful if your cluster's NetworkPolicies already allow API-server ingress).
# ---------------------------------------------------------------------------

# --- Linode/Akamai LKE defaults (Calico CNI) ---
KF_APISERVER_CIDRS=192.168.128.0/17
KF_POD_CIDR=10.2.0.0/16

# --- Google GKE example ---
# KF_APISERVER_CIDRS=10.128.0.0/9    # GKE node subnet (varies by region/config)
# KF_POD_CIDR=10.4.0.0/14            # GKE pod range (default VPC-native)

# --- AWS EKS example ---
# KF_APISERVER_CIDRS=192.168.0.0/16  # EKS managed node group subnet
# KF_POD_CIDR=10.100.0.0/16          # EKS pod CIDR (aws-node CNI default)

# --- Azure AKS example ---
# KF_APISERVER_CIDRS=10.224.0.0/12   # AKS node CIDR (default kubenet)
# KF_POD_CIDR=10.244.0.0/16          # AKS pod CIDR (default kubenet)

# --- Skip the patch entirely ---
# KF_APISERVER_CIDRS=
# KF_POD_CIDR=
